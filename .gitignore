# One .gitignore for the whole repo (frontend, api, ml, scripts).

# Planning docs stay local
docs/
CLAUDE.local.md

# Secrets: only the examples are committed
.env
.env.*
!.env.example
*.pem
*.key

# Node / pnpm (frontend)
node_modules/
.pnpm-store/
dist/
dist-ssr/
*.tsbuildinfo
.vite/
coverage/
*.local

# Python (ml)
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
*.egg-info/

# Local databases
*.db
*.db-journal
*.sqlite
*.sqlite3

# Rider data, screenshots and model inputs never go in git (agents.md §5)
private_data/
ml/results/
api/.llm-cache/

# Local embedded Postgres (PGlite)
api/.pglite*/

# Logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*

# Editors and OS
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Google OAuth client secret downloads
client_secret_*.json

# Claude Code project config (skills, plugins): local only
.claude/
