# The API (Node 24 + Express) serving the built PWA from the same origin (ADR-1). Build context: the repo root.
FROM node:24-slim AS web
RUN corepack enable
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY frontend/package.json frontend/
COPY api/package.json api/
RUN pnpm install --frozen-lockfile
COPY frontend frontend
RUN pnpm --filter coinvoy-frontend build

FROM node:24-slim
RUN corepack enable
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY frontend/package.json frontend/
COPY api/package.json api/
RUN pnpm install --frozen-lockfile --prod --filter coinvoy-api
COPY api api
COPY --from=web /app/frontend/dist frontend/dist
ENV NODE_ENV=production PORT=8000
EXPOSE 8000
USER node
CMD ["node", "api/src/index.ts"]
