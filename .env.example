# Copy to .env (git-ignored) at the repo root. The API (api/) reads it; the frontend needs nothing.
# Real environment variables win over this file. Every value below is optional unless marked "required".
# Commented-out lines show the default; uncomment only to change it.

# ── Server ──────────────────────────────────────────────────────────────────────────────────────────────
# PORT=8000
# Empty = embedded Postgres (PGlite) in api/.pglite, no setup. Production: postgres://user:pass@host/db
# DATABASE_URL=
# With the embedded database, DBeaver/psql can connect while pnpm dev runs: host 127.0.0.1, this port, database
# postgres, user postgres, no password. 0 = off.
# PGLITE_PORT=5433

# Public origin the browser uses (the Vite dev server locally). The Google redirect URI is APP_URL/api/auth/google/callback
APP_URL=http://localhost:5173
# true on HTTPS (production)
COOKIE_SECURE=false
SESSION_TTL_DAYS=7
# Requests per minute per IP on /api/auth/*
# AUTH_RATE_PER_MIN=30
# One JSON line per request on stdout (method, path, status, ms, user id; no bodies or query strings)
LOG_REQUESTS=true

# ── ML service (engine, BM classifier, Penyata PDF) ─────────────────────────────────────────────────────
# pnpm dev starts it on 8001.
ML_URL=http://127.0.0.1:8001
# Shared secret between the API and the ML service. Required in production; set the same value on both.
ML_TOKEN=
# Read by the ML service: "gbm" switches the forecast mean to the pooled rate model. Leave unset until it wins the
# REAL backtest (uv run --directory ml python -m scripts.backtest <csv> --rate-model gbm).
# RATE_MODEL=
# BM cost phrases below this classifier confidence go to the LLM
# BM_CLASSIFIER_THRESHOLD=0.7

# ── Sign-in ─────────────────────────────────────────────────────────────────────────────────────────────
# Google Cloud Console → Clients → Web application (docs/GOOGLE_AUTH_PORTABLE.md §3). Leave empty to use the demo only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# "Cuba demo" on the login screen: a temporary demo user per tap
DEMO_ENABLED=true
# Google emails (comma-separated) that can open the team usage view at /admin. Demo accounts never can.
ADMIN_EMAILS=

# ── AI (any provider with an OpenAI-compatible API) ─────────────────────────────────────────────────────
#   OpenRouter: https://openrouter.ai/api/v1                              model e.g. google/gemini-2.5-flash
#   Gemini:     https://generativelanguage.googleapis.com/v1beta/openai/  model e.g. gemini-2.5-flash
#   OpenAI:     https://api.openai.com/v1                                 model e.g. gpt-4.1-mini
#   Anthropic:  https://api.anthropic.com/v1/                             model e.g. claude-haiku-5-5
#   Ollama:     http://localhost:11434/v1  (any non-empty key)            model e.g. qwen2.5vl
# Leave every key empty to run without AI (manual entry, Semak Layak and the lender rules still work).

# Recommended (free, no data kept): Groq. Get a key at https://console.groq.com/keys and turn on
# Zero Data Retention under Settings → Data Controls. Check your daily limits at console.groq.com/settings/limits.
#
# Merge or split the keys: false = every job uses LLM_API_KEY below (the per-job keys are ignored);
# true = each job uses its own LLM_API_KEY_* and a job left without a key is off. The API logs which key each job uses.
LLM_SPLIT_KEYS=false

# Shared key and provider (merge mode), and the default model for any job without its own.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b

# Job 1, OCR: reads earnings screenshots in Snap. Needs a vision model (Groq: qwen/qwen3.8-27b).
LLM_API_KEY_SNAP=
LLM_BASE_URL_SNAP=
LLM_MODEL_SNAP=qwen/qwen3.8-27b

# Job 2, chatbot: Tanya, and the lender and message checks (same key and URL; the lender check can use its own model).
# Tanya needs a model with tool calling (Groq: openai/gpt-oss-120b).
LLM_API_KEY_TANYA=
LLM_BASE_URL_TANYA=
LLM_MODEL_TANYA=openai/gpt-oss-120b
LLM_MODEL_LENDER=openai/gpt-oss-120b

# Job 3, recommendations: Tabung pot suggestions and naming, and BM cost phrases the classifier isn't sure of
# (same key and URL; BM can use its own model). A small fast model is enough (Groq: openai/gpt-oss-20b).
LLM_API_KEY_RECO=
LLM_BASE_URL_RECO=
LLM_MODEL_RECO=openai/gpt-oss-20b
LLM_MODEL_BM=openai/gpt-oss-20b

# Limits: AI calls per rider per day for each job, and for everyone per month (NFR-8). Uncomment to change.
# LLM_DAILY_SNAP=15
# LLM_DAILY_TANYA=20
# LLM_DAILY_LENDER=5
# LLM_DAILY_BM=30
# LLM_DAILY_RECO=10
# LLM_MONTHLY_CALL_CAP=20000
# LLM_TIMEOUT_S=60
# Demo day: save each Snap answer and replay it when the same screenshot comes again (a live demo without the network)
# DEMO_LLM_CACHE=false

# Shown on the privacy page (PDPA: where screenshots and chat are processed). Update when you switch provider.
LLM_PROVIDER_NAME=Groq
LLM_REGION_NOTE=Processed in the United States by Groq. Groq does not keep the data (zero data retention).

# ── Payday reminder (Web Push) ──────────────────────────────────────────────────────────────────────────
# Generate a pair once: pnpm --filter coinvoy-api exec web-push generate-vapid-keys. Empty = reminders off (the toggle says so).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ── Contributions: VERIFY each against the official source before the pitch (docs/todo.md) ───────────────
# i-Saraan Plus: the government adds this share of the rider's EPF contribution, up to the yearly cap (in sen)
# ISARAAN_MATCH_RATE=0.2
# ISARAAN_MATCH_CAP_SEN=50000
# PERKESO SKSPS rate for p-hailing, and whether platforms already deduct it
# PERKESO_RATE=0.0125
# PERKESO_DEDUCTED_AT_SOURCE=true
