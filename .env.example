# Copy this file to .env. Only the API reads it.
# Lines starting with # are optional; the value shown is the default.

# --- Server ---
# PORT=8000
# Leave empty to use the built-in local database. On a server: postgres://user:pass@host/db
# DATABASE_URL=
# Port for opening the local database in DBeaver while the app runs. 0 turns it off.
# PGLITE_PORT=5433
APP_URL=http://localhost:5173
# Set to true when the site runs on https.
COOKIE_SECURE=false
SESSION_TTL_DAYS=7
# AUTH_RATE_PER_MIN=30
LOG_REQUESTS=true

# --- ML service ---
ML_URL=http://127.0.0.1:8001
# Any secret string. Needed on a server; use the same value for the API and the ML service.
ML_TOKEN=
# Set to gbm to try the newer forecast model (only after it wins the real backtest).
# RATE_MODEL=
# BM_CLASSIFIER_THRESHOLD=0.7

# --- Sign-in ---
# From Google Cloud Console. Leave empty to use only the demo login.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DEMO_ENABLED=true
# Google emails that can open /admin, separated by commas.
ADMIN_EMAILS=

# --- AI ---
# We use Groq (free): get a key at console.groq.com/keys and turn on Zero Data Retention.
# Any OpenAI-compatible provider works if you change the URL and models.
# Leave the keys empty to run without AI.

# false: one key for everything (LLM_API_KEY).
# true: a separate key for each job below. A job without a key is switched off.
LLM_SPLIT_KEYS=false

LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b

# Reading earnings screenshots (needs a model that can see images)
LLM_API_KEY_SNAP=
LLM_BASE_URL_SNAP=
LLM_MODEL_SNAP=qwen/qwen3.8-27b

# Tanya chat, the lender check and the message check
LLM_API_KEY_TANYA=
LLM_BASE_URL_TANYA=
LLM_MODEL_TANYA=openai/gpt-oss-120b
LLM_MODEL_LENDER=openai/gpt-oss-120b

# Pot suggestions and BM cost phrases
LLM_API_KEY_RECO=
LLM_BASE_URL_RECO=
LLM_MODEL_RECO=openai/gpt-oss-20b
LLM_MODEL_BM=openai/gpt-oss-20b

# Daily AI limits per rider, and a monthly limit for everyone.
# LLM_DAILY_SNAP=15
# LLM_DAILY_TANYA=20
# LLM_DAILY_LENDER=5
# LLM_DAILY_BM=30
# LLM_DAILY_RECO=10
# LLM_MONTHLY_CALL_CAP=20000
# LLM_TIMEOUT_S=60
# For demo day: remembers screenshot answers so a repeat works without the internet.
# DEMO_LLM_CACHE=false

# Shown on the privacy page so riders know where their data goes.
LLM_PROVIDER_NAME=Groq
LLM_REGION_NOTE=Processed in the United States by Groq. Groq does not keep the data (zero data retention).

# --- Payday reminder ---
# Make a key pair once with: pnpm --filter coinvoy-api exec web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Government contributions (check these against the official sites before the pitch) ---
# ISARAAN_MATCH_RATE=0.2
# ISARAAN_MATCH_CAP_SEN=50000
# PERKESO_RATE=0.0125
# PERKESO_DEDUCTED_AT_SOURCE=true
