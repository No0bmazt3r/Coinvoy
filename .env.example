# Copy to .env (git-ignored) at the repo root. The backend reads it; the frontend needs nothing.

# Local default is SQLite in backend/coinvoy.db. Production: postgresql+psycopg://user:pass@host/db
# DATABASE_URL=

# Public origin the browser uses (the Vite dev server locally). The Google redirect URI is APP_URL/api/auth/google/callback
APP_URL=http://localhost:5173
# true on HTTPS (production)
COOKIE_SECURE=false
SESSION_TTL_DAYS=7

# Google Cloud Console → Clients → Web application (docs/GOOGLE_AUTH_PORTABLE.md §3). Leave empty to use the demo only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# "Cuba demo" on the login screen: a temporary demo user per tap
DEMO_ENABLED=true
