# Copy to .env (git-ignored) at the repo root. The API (api/) reads it; the frontend needs nothing.

# Empty = embedded Postgres (PGlite) in api/.pglite, no setup. Production: postgres://user:pass@host/db
# DATABASE_URL=

# The Python ML service (engine, BM classifier, Penyata PDF). pnpm dev starts it on 8001.
ML_URL=http://127.0.0.1:8001
# Shared secret between the API and the ML service. Required in production; set the same value on both.
ML_TOKEN=

# Public origin the browser uses (the Vite dev server locally). The Google redirect URI is APP_URL/api/auth/google/callback
APP_URL=http://localhost:5173
# true on HTTPS (production)
COOKIE_SECURE=false
SESSION_TTL_DAYS=7

# Google Cloud Console → Clients → Web application (docs/GOOGLE_AUTH_PORTABLE.md §3). Leave empty to use the demo only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# "Cuba demo" on the login screen: a temporary demo user per tap
DEMO_ENABLED=true

# LLM: any provider with an OpenAI-compatible API. Switch provider by changing these three lines.
#   OpenRouter: https://openrouter.ai/api/v1                              model e.g. google/gemini-2.5-flash
#   Gemini:     https://generativelanguage.googleapis.com/v1beta/openai/  model e.g. gemini-2.5-flash
#   OpenAI:     https://api.openai.com/v1                                 model e.g. gpt-4.1-mini
#   Anthropic:  https://api.anthropic.com/v1/                             model e.g. claude-haiku-5-5
#   Ollama:     http://localhost:11434/v1  (any non-empty key)            model e.g. qwen2.5vl
# Leave the key empty to run without AI (manual entry still works).
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=
# Optional per-route overrides (empty = LLM_MODEL). Snap needs a vision model.
LLM_MODEL_SNAP=
LLM_MODEL_TANYA=
LLM_MODEL_LENDER=
LLM_MODEL_BM=
LLM_MODEL_RECO=
# Optional: a separate key (and provider URL) per job. Empty = LLM_API_KEY / LLM_BASE_URL above.
#   SNAP  = receipt/screenshot OCR (needs a vision model)
#   TANYA = the chatbot and the lender check
#   RECO  = pot recommendations and BM text
LLM_API_KEY_SNAP=
LLM_BASE_URL_SNAP=
LLM_API_KEY_TANYA=
LLM_BASE_URL_TANYA=
LLM_API_KEY_RECO=
LLM_BASE_URL_RECO=
# Shown on the privacy page (PDPA: where screenshots and chat are processed). Update when you switch provider.
LLM_PROVIDER_NAME=
LLM_REGION_NOTE=

# Payday reminder (Web Push). Generate a pair once: pnpm --filter coinvoy-api exec web-push generate-vapid-keys
# Empty = reminders off (the toggle says so).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Google emails (comma-separated) that can open the team usage view at /admin. Demo accounts never can.
ADMIN_EMAILS=
# One JSON line per request on stdout (method, path, status, ms, user id; no bodies or query strings)
LOG_REQUESTS=true

# ML service: "gbm" switches the forecast mean to the pooled rate model. Leave unset until it wins the REAL backtest
# (uv run --directory ml python -m scripts.backtest <csv> --rate-model gbm).
# RATE_MODEL=
